# Caddy reverse proxy — terminates HTTPS and forwards to the FastAPI container.
# Caddy auto-provisions and renews a Let's Encrypt certificate for this domain,
# as long as the domain's DNS A record points at this server and ports 80/443 are open.
#
# Set the IP for wizardocs.duckdns.org at duckdns.org (to the EC2 Elastic IP)
# before starting — Caddy cannot get a cert until the name resolves.

wizardocs.duckdns.org {
	reverse_proxy api:8000
}
